{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "openbookcorner",
  "main": "./worker.ts",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "ENVIRONMENT": "production",
    "APP_NAME": "OpenBookCorner",
    "APP_ORIGIN": "https://openbookcorner.jizu.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openbookcorner",
      "database_id": "11371372-82fe-488e-b497-2e94518ce488",
      "migrations_dir": "../../db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "COVERS", "bucket_name": "openbookcorner-covers" }],

  // Isolated preview resources: SEPARATE D1 + R2 (never production data), per
  // Copilot security review. ENVIRONMENT=preview relaxes origin trust only to
  // localhost + our own *.openbookcorner.jizu.dev (NOT *.workers.dev).
  "previews": {
    "vars": {
      "ENVIRONMENT": "preview",
      "APP_NAME": "OpenBookCorner (Preview)",
      "APP_ORIGIN": "https://openbookcorner.jizu.dev"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "openbookcorner-preview",
        "database_id": "6d67a9a0-0ac1-4c50-bbef-6c035e3300a7"
      }
    ],
    "r2_buckets": [{ "binding": "COVERS", "bucket_name": "openbookcorner-covers-preview" }]
  }

  // NOTE: the custom-domain route (openbookcorner.jizu.dev) is intentionally NOT
  // in this config. Including a custom_domain route makes `wrangler dev` simulate
  // that host and rewrite the request Origin, which breaks Better Auth's origin
  // check locally/in E2E. The custom domain is already bound to this Worker in
  // Cloudflare; `wrangler deploy` keeps it attached.
}

