{
  "name": "@obc/root",
  "version": "0.0.0",
  "private": true,
  "workspaces": ["apps/*", "db", "e2e"],
  "type": "module",
  "scripts": {
    "dev": "bun --filter @obc/api --filter @obc/app dev",
    "dev:api": "bun --cwd apps/api dev",
    "dev:app": "bun --cwd apps/app dev",
    "build": "bun --cwd apps/app generate-routes && bun --filter @obc/app build",
    "cf:build": "bun install && bun run build",
    "cf:deploy": "bun --cwd apps/app exec wrangler deploy",
    "cf:preview": "bun --cwd apps/app exec wrangler versions upload",
    "typecheck": "tsc --build",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bun --cwd e2e test",
    "db:generate": "bun --cwd db generate",
    "db:migrate:local": "bun --cwd db migrate:local",
    "db:migrate:remote": "bun --cwd db migrate:remote",
    "db:seed:local": "bun --cwd db seed:local",
    "db:seed:remote": "bun --cwd db seed:remote",
    "deploy": "bun --cwd apps/api deploy && bun --cwd apps/app deploy"
  },
  "devDependencies": {
    "@types/node": "^22",
    "oxlint": "^1.19.0",
    "typescript": "~5.9.2",
    "vite": "^6.3.5",
    "vitest": "^2.1.9",
    "wrangler": "^4.42.0"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.3"
}
