{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn"],
  "env": { "browser": true, "es2024": true },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/.cache/**",
    "**/routeTree.gen.ts",
    "**/.migration-old/**",
    "**/node_modules/**"
  ]
}
