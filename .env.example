# Copy to .env and fill in. Used by docker-compose.yml.

# Public origin the app is served on (must match how users reach it, for
# Better Auth cookies/CSRF). e.g. https://library.example.com or http://<vps-ip>:3000
APP_ORIGIN=http://localhost:3000

# 32+ char random secret for signing sessions (openssl rand -base64 48).
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# --- Litestream backup (optional) ---
LITESTREAM_ENDPOINT=https://<account>.r2.cloudflarestorage.com
LITESTREAM_BUCKET=openbookcorner-backup
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
