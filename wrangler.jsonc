{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "openbookcorner",
  "main": "./apps/app/worker.ts",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "preview_urls": true,
  "assets": {
    "directory": "./apps/app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "ENVIRONMENT": "production",
    "APP_NAME": "OpenBookCorner",
    "APP_ORIGIN": "https://openbookcorner.jizu.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openbookcorner",
      "database_id": "11371372-82fe-488e-b497-2e94518ce488",
      "preview_database_id": "6d67a9a0-0ac1-4c50-bbef-6c035e3300a7",
      "migrations_dir": "./db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "COVERS", "bucket_name": "openbookcorner-covers" }],

  // Custom-domain route for BOTH production and preview traffic. Preview URLs
  // become <preview-name>.openbookcorner.jizu.dev, which the existing advanced
  // certificate (*.openbookcorner.jizu.dev) already covers — no ACM/Total TLS
  // needed, and not *.workers.dev (so it isn't blocked by corporate proxies).
  // This route lives ONLY in the root config (used by Workers Builds + prod
  // deploy); apps/app/wrangler.jsonc has NO route so `wrangler dev`/E2E keep a
  // clean localhost Origin for Better Auth.
  "routes": [
    { "pattern": "openbookcorner.jizu.dev", "custom_domain": true, "previews_enabled": true }
  ],

  // Required for `wrangler preview`. Previews run on the SAME Worker, bound to
  // ISOLATED preview resources (separate D1 + R2 — never production data), per
  // Copilot security review. ENVIRONMENT=preview so auth trusts localhost + our
  // own *.openbookcorner.jizu.dev preview origins (NOT *.workers.dev). The
  // per-PR preview host is pr-<n>.openbookcorner.jizu.dev; the Worker derives
  // APP_ORIGIN from the request in preview, so no static origin is set here.
  // BETTER_AUTH_SECRET is provided per-preview by the workflow (preview secret).
  "previews": {
    "vars": {
      "ENVIRONMENT": "preview",
      "APP_NAME": "OpenBookCorner (Preview)"
      // Path-based tenancy (ADR 0003): tenants are `/t/:slug` on the single
      // preview origin (preview.openbookcorner.jizu.dev) — no subdomains, no
      // cert/DNS work. The preview has real multi-tenancy at
      // preview.openbookcorner.jizu.dev/t/:slug.
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "openbookcorner-preview",
        "database_id": "6d67a9a0-0ac1-4c50-bbef-6c035e3300a7"
      }
    ],
    "r2_buckets": [{ "binding": "COVERS", "bucket_name": "openbookcorner-covers-preview" }]
  }

  // Workers Builds uses DEFAULT commands from Root "/": `bun run build` +
  // `npx wrangler deploy` / `npx wrangler preview` (which read THIS file).
}
